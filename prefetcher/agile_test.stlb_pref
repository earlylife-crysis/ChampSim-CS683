// Added STLB Sampler and FDT as an extern variable
extern sampler STLB_sampler;
extern fdt STLB_FDT;

// FPQs for each base prefetcher
fpq stp_fpq = fpq();
fpq h2p_fpq = fpq();
fpq masp_fpq = fpq();
fpq morrigan_fpq = fpq();

// Counters to determine chosen prefetcher
extern uint64_t pref_enable;  // 8-bit counter
extern uint64_t select_1;  // 6-bit counter
extern uint64_t select_2;  // 2-bit counter
extern uint64_t pref_enable_morrigan;

// Defines for saturation limits of above counters
#define PREF_ENABLE_MAX 255
#define SELECT_1_MAX 63
#define SELECT_2_MAX 3  // Setting max values to a high number to see the patterns in the counters
#define PREF_ENABLE_MORRIGAN_MAX 65535

// Defines for enable thresholds of above counters
#define PREF_ENABLE_THRESH 128
#define SELECT_1_THRESH 32
#define SELECT_2_THRESH 2
#define PREF_ENABLE_MORRIGAN_THRESH 65535

// Function prototypes for various prefetchers (first argument corresponds to cpu ID)
void stp_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);
void h2p_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);
void masp_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);
void morrigan_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Function prototype for SBFP
// uint32_t -> cpu ID
// uint64_t -> prefetch address
// bool -> indicates whether the prefetcher is enabled
// fpq* -> pointer to the FPQ corresponding to the prefetcher
void sbfp_operate(uint32_t, uint64_t, bool, fpq*, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Function prototype for per-prefetcher SBFP
void sbfp_operate_sep(uint32_t, uint64_t, bool, fpq*, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Function prototype for NaiveFP (for Morrigan)
void naivefp_operate(uint32_t, uint64_t, bool, fpq*, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Decision structures for H2P prefetcher
int64_t h2p_history[2] = {0, 0};  // Entry with index 0 is the more recent entry
uint64_t prev_addr = 0;

// WAO: Added individual STLB samplers and FDTs as extern variables
extern sampler stp_sampler;
extern fdt stp_fdt;
extern sampler h2p_sampler;
extern fdt h2p_fdt;
extern sampler masp_sampler;
extern fdt masp_fdt;
extern sampler morrigan_sampler;
extern fdt morrigan_fdt;

// WAO: Boolean variables to indicate whether prefetcher is enabled
extern bool stp_enable;
extern bool h2p_enable;
extern bool masp_enable;
extern bool morrigan_enable;


// Structures for MASP
#define MASP_TRACKER_SIZE 64
#define MASP_ASSOC 4

class MASP_set
{
	private:
	uint64_t* ip_tag;
	uint64_t* prev_vpn;
	int64_t* stride;
	uint8_t* valid;
	uint8_t* lru;

	public:
	bool check_hit(uint64_t, int64_t*, uint64_t*);  // Arguments are IP tag and pointers to stride and prev_vpn variables (for return)
	void update_entry(uint64_t, int64_t, uint64_t);  // Arguments are IP tag, stride and prev_vpn
	void insert_entry(uint64_t, uint64_t);  // Arguments are IP tag and prev_vpn
	void print_set();
	MASP_set()
	{
		ip_tag = new uint64_t[MASP_ASSOC]();
		prev_vpn = new uint64_t[MASP_ASSOC]();
		stride = new int64_t[MASP_ASSOC]();
		valid = new uint8_t[MASP_ASSOC]();
		lru = new uint8_t[MASP_ASSOC]();
	}
};

MASP_set masp_tracker[MASP_TRACKER_SIZE/MASP_ASSOC];

// Decision structures for Morrigan prefetcher
MARKOV_S1 irip_s1[(int)pow(2.0, ceil(log2(PT_S1_SETS/PT_S1_ASSOC)))][PT_S1_ASSOC];
MARKOV_S2 irip_s2[(int)pow(2.0, ceil(log2(PT_S2_SETS/PT_S2_ASSOC)))][PT_S2_ASSOC];
MARKOV_S4 irip_s4[(int)pow(2.0, ceil(log2(PT_S4_SETS/PT_S4_ASSOC)))][PT_S4_ASSOC];
MARKOV_S8 irip_s8[(int)pow(2.0, ceil(log2(PT_S8_SETS/PT_S8_ASSOC)))][PT_S8_ASSOC];
uint64_t s_timer;
uint64_t previous_vpn;

// Function prototypes for Morrigan prefetcher
void show_s1();
void show_s2();
void show_s4();
void show_s8();
uint32_t hash32(uint32_t);
int search_markov_table(int, uint64_t, int);
void reset_frequency();
int lru_policy(int, int);
int random_policy(int);
int lfu_policy(int, int);
bool sortcol(const vector<int>&, const vector<int>&);

// Free prefetching function for Morrigan
void CACHE::free_prefetching(uint64_t ip, uint64_t addr, int cache_line_position_n, uint64_t pf_addr, int * free_indexes, uint64_t instr_id, int type, int iflag){
	int fi_lim = -100;
	for(int fi=13; fi>=0; fi--){
		fi_lim = free_indexes[fi] + cache_line_position_n;
		if((fi_lim >= 0) && (fi_lim <= 7))
			prefetch_page(ip, addr, pf_addr + free_indexes[fi], FILL_L2, 0, 1, 1, free_indexes[fi], instr_id, type, iflag, 1, 0, 1);
	}   
}

void CACHE::stlb_prefetcher_initialize() 
{
	cout << "Agile STLB Prefetcher on CPU " << cpu << endl;
}

void CACHE::stlb_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Check for hits in each of the FPQs
	bool stp_hit = stp_fpq.hit_fpq(addr);
	bool h2p_hit = h2p_fpq.hit_fpq(addr);
	bool masp_hit = masp_fpq.hit_fpq(addr);
	bool morrigan_hit = false;

	// Check for hits in Morrigan FPQ only for instruction translations
	if(iflag)
	{
		morrigan_hit = morrigan_fpq.hit_fpq(addr);
	}

	// Update counters on the basis of above hits (conditions derived from paper)
	if(stp_hit || h2p_hit || masp_hit)  // If hit in any FPQ
	{
		if(pref_enable != PREF_ENABLE_MAX)
		{
			pref_enable++;
		}
	}
	else
	{
		if(pref_enable != 0)
		{
			pref_enable--;
		}
	}

	if((stp_hit && !h2p_hit && !masp_hit) || (masp_hit && !stp_hit && !h2p_hit) || (!h2p_hit && stp_hit && masp_hit))
	{
		if(select_1 != 0)
		{
			select_1--;
		}
	}
	else if(h2p_hit && !stp_hit && !masp_hit)
	{
		if(select_1 != SELECT_1_MAX)
		{
			select_1++;
		}
	}

	if((stp_hit && !h2p_hit && !masp_hit) || (!masp_hit && stp_hit && h2p_hit))
	{
		if(select_2 != SELECT_2_MAX)
		{
			select_2++;
		}
	}
	else if((masp_hit && !stp_hit && !h2p_hit) || (!stp_hit && masp_hit && h2p_hit))
	{
		if(select_2 != 0)
		{
			select_2--;
		}
	}

	// Update Morrigan counter for instruction translations
	if(iflag)
	{
		if(morrigan_hit)
		{
			if(pref_enable_morrigan != PREF_ENABLE_MORRIGAN_MAX)
			{
				pref_enable_morrigan++;
			}
		}
		else
		{
			if(pref_enable_morrigan != 0)
			{
				pref_enable_morrigan--;
			}
		}
	}

	// Request each constituent prefetcher to operate
	// Decision on whether or not to operate will be taken by the prefetcher
	h2p_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
	masp_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
	stp_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
	morrigan_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
}

