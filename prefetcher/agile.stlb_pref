// Added by WrongAnswersOnly (WAO)
// Implementation of Agile TLB Prefetcher 
#include "cache.h"
#include "ooo_cpu.h"

// Added header files
#include "sampler.h"
#include "fdt.h"
#include "fpq.h"

// Added STLB Sampler and FDT as an extern variable
extern sampler STLB_sampler;
extern fdt STLB_FDT;

// FPQs for each base prefetcher
fpq stp_fpq = fpq();
fpq h2p_fpq = fpq();
fpq masp_fpq = fpq();

// Counters to determine chosen prefetcher
uint8_t pref_enable = 0;  // 8-bit counter
uint8_t select_1 = 0;  // 6-bit counter
uint8_t select_2 = 0;  // 2-bit counter

// Defines for saturation limits of above counters
#define PREF_ENABLE_MAX 255
#define SELECT_1_MAX 63
#define SELECT_2_MAX 3

// Defines for enable thresholds of above counters
#define PREF_ENABLE_THRESH 128
#define SELECT_1_THRESH 32
#define SELECT_2_THRESH 2

// Function prototypes for various prefetchers (first argument corresponds to cpu ID)
void stp_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);
void h2p_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);
void masp_operate(uint32_t, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Function prototype for SBFP
// uint32_t -> cpu ID
// uint64_t -> prefetch address
// bool -> indicates whether the prefetcher is enabled
// fpq* -> pointer to the FPQ corresponding to the prefetcher
void sbfp_operate(uint32_t, uint64_t, bool, fpq*, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Function prototype for per-prefetcher SBFP
void sbfp_operate_sep(uint32_t, uint64_t, bool, fpq*, uint64_t, uint64_t, uint8_t, uint8_t, int, int, int*, uint64_t, int);

// Decision structures for H2P prefetcher
int64_t h2p_history[2] = {0, 0};  // Entry with index 0 is the more recent entry
uint64_t prev_addr = 0;

// WAO: Added individual STLB samplers and FDTs as extern variables
extern sampler stp_sampler;
extern fdt stp_fdt;
extern sampler h2p_sampler;
extern fdt h2p_fdt;
extern sampler masp_sampler;
extern fdt masp_fdt;

// WAO: Boolean variables to indicate whether prefetcher is enabled
extern bool stp_enable;
extern bool h2p_enable;
extern bool masp_enable;

// Structures for MASP
#define MASP_TRACKER_SIZE 64
#define MASP_ASSOC 4

class MASP_set
{
	private:
	uint64_t* ip_tag;
	uint64_t* prev_vpn;
	int64_t* stride;
	uint8_t* valid;
	uint8_t* lru;

	public:
	bool check_hit(uint64_t, int64_t*, uint64_t*);  // Arguments are IP tag and pointers to stride and prev_vpn variables (for return)
	void update_entry(uint64_t, int64_t, uint64_t);  // Arguments are IP tag, stride and prev_vpn
	void insert_entry(uint64_t, uint64_t);  // Arguments are IP tag and prev_vpn
	void print_set();
	MASP_set()
	{
		ip_tag = new uint64_t[MASP_ASSOC]();
		prev_vpn = new uint64_t[MASP_ASSOC]();
		stride = new int64_t[MASP_ASSOC]();
		valid = new uint8_t[MASP_ASSOC]();
		lru = new uint8_t[MASP_ASSOC]();
	}
};

MASP_set masp_tracker[MASP_TRACKER_SIZE/MASP_ASSOC];

void CACHE::stlb_prefetcher_initialize() 
{
	cout << "Agile STLB Prefetcher on CPU " << cpu << endl;
}

void CACHE::stlb_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Check for hits in each of the FPQs
	bool stp_hit = stp_fpq.hit_fpq(addr);
	bool h2p_hit = h2p_fpq.hit_fpq(addr);
	bool masp_hit = masp_fpq.hit_fpq(addr);

	// Update counters on the basis of above hits (conditions derived from paper)
	if(stp_hit || h2p_hit || masp_hit)  // If hit in any FPQ
	{
		if(pref_enable != PREF_ENABLE_MAX)
		{
			pref_enable++;
		}
	}
	else
	{
		if(pref_enable != 0)
		{
			pref_enable--;
		}
	}

	if((stp_hit && !h2p_hit && !masp_hit) || (masp_hit && !stp_hit && !h2p_hit) || (!h2p_hit && stp_hit && masp_hit))
	{
		if(select_1 != 0)
		{
			select_1--;
		}
	}
	else if(h2p_hit && !stp_hit && !masp_hit)
	{
		if(select_1 != SELECT_1_MAX)
		{
			select_1++;
		}
	}

	if((stp_hit && !h2p_hit && !masp_hit) || (!masp_hit && stp_hit && h2p_hit))
	{
		if(select_2 != SELECT_2_MAX)
		{
			select_2++;
		}
	}
	else if((masp_hit && !stp_hit && !h2p_hit) || (!stp_hit && masp_hit && h2p_hit))
	{
		if(select_2 != 0)
		{
			select_2--;
		}
	}

	// Request each constituent prefetcher to operate
	// Decision on whether or not to operate will be taken by the prefetcher
	h2p_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
	masp_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
	stp_operate(cpu, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
}

void CACHE::stlb_prefetcher_cache_fill(uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t evicted_addr)
{

}

void CACHE::stlb_prefetcher_final_stats(uint64_t prefetches, uint64_t hits, uint64_t misses, uint64_t swap, uint64_t dupli, uint64_t free, uint64_t real, uint64_t * mmu_cache_demand_hits, uint64_t * mmu_cache_prefetch_hits, uint64_t * rfhits, uint64_t * free_hits, uint64_t mr[4][4], uint64_t stlb_misses[2])
{
	cout << endl << "*******************************************" << endl;
	cout << "CPU " << cpu << " STLB -- L2-TLB Prefetcher final stats" << endl;
	cout << "*******************************************" << endl;

	cout << endl << "-------------------------------------------" << endl;
	cout << "D-STLB MISSES: " << stlb_misses[0] << endl;
	cout << "I-STLB MISSES: " << stlb_misses[1] << endl;
	cout << "-------------------------------------------" << endl;

	cout << endl << "-------------------------------------------" << endl;
	cout << "PQ hits: " << hits << endl; 
	cout << "PQ misses: " << misses << endl;
	cout << "-------------------------------------------" << endl;
	cout << "Counter Values\n";
	cout << (uint)pref_enable << " " << (uint)select_1 << " " << (uint)select_2 << endl;
	cout << "\nSTP FPQ Contents\n";
	stp_fpq.print_fpq();
	cout << "\nMASP FPQ Contents\n";
	masp_fpq.print_fpq();
	cout << "\nH2P FPQ Contents\n";
	h2p_fpq.print_fpq();
	cout << "\nMASP Tracker Contents\n";
	for(int i = 0; i < MASP_TRACKER_SIZE/MASP_ASSOC; i++)
	{
		cout << "\nContents of Set " << i << endl;
		masp_tracker[i].print_set();
	}
	cout << "\nH2P History Structure Contents\n";
	cout << (uint) h2p_history[0] << " " << (uint) h2p_history[1] << " " << (uint) prev_addr << endl;
}

void stp_operate(uint32_t cpu, uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Check if STP should be operated
	stp_enable = false;

	if(pref_enable >= PREF_ENABLE_THRESH && select_1 < SELECT_1_THRESH && select_2 >= SELECT_2_THRESH)  // Condition for STP operation
	{
		stp_enable = true;
	}

	// Operate STP
	uint64_t current_vpn, pf_addr;
	current_vpn = addr;
	
	// Prefetch 4 page translations with offsets (-2, -1, 1, 2)
	for(int i = 0; i < 5; i++)
	{
		if(i == 2)  // Same page as current vpn
		{
			continue;
		}

		pf_addr = current_vpn + i - 2;

		// Prefetch to PQ only if STP is enabled
		if(stp_enable)
		{
			ooo_cpu[cpu].STLB.prefetch_page(ip, addr, pf_addr, FILL_L2, 0, 0, 0, 0, instr_id, type, iflag, 0, 0, 0);
			stp_fpq.add_fpq(pf_addr);
		}
		else  // Add addresses to FPQ
		{
			stp_fpq.add_fpq(pf_addr);
		}

		// Perform free prefetches if SBFP is enabled
		#ifdef SBFP_ENABLE
		sbfp_operate(cpu, pf_addr, stp_enable, &stp_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
		#endif

		#ifdef AGILE_SEP_SAMPLER
		sbfp_operate_sep(cpu, pf_addr, stp_enable, &stp_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
		#endif
	}
}

void h2p_operate(uint32_t cpu, uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Check if H2P should be operated
	h2p_enable = false;

	if(pref_enable >= PREF_ENABLE_THRESH && select_1 >= SELECT_1_THRESH)
	{
		h2p_enable = true;
	}

	// Operate H2P
	uint64_t current_vpn, pf_addr;
	current_vpn = addr;

	// Update history structures
	h2p_history[1] = h2p_history[0];
	h2p_history[0] = addr - prev_addr;
	prev_addr = addr;

	// Prefetch 2 page translations based on saved history
	for(int i = 0; i < 2; i++)
	{
		pf_addr = current_vpn + h2p_history[i];

		// Prefetch to PQ only if H2P is enabled
		if(h2p_enable)
		{
			ooo_cpu[cpu].STLB.prefetch_page(ip, addr, pf_addr, FILL_L2, 0, 0, 0, 0, instr_id, type, iflag, 0, 0, 0);
			h2p_fpq.add_fpq(pf_addr);
		}
		else  // Add addresses to FPQ
		{
			h2p_fpq.add_fpq(pf_addr);
		}

		// Perform free prefetches if SBFP is enabled
		#ifdef SBFP_ENABLE
		sbfp_operate(cpu, pf_addr, h2p_enable, &h2p_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
		#endif

		#ifdef AGILE_SEP_SAMPLER
		sbfp_operate_sep(cpu, pf_addr, h2p_enable, &h2p_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
		#endif
	}
}

void masp_operate(uint32_t cpu, uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Check if MASP should be operated
	masp_enable = false;

	if(pref_enable >= PREF_ENABLE_THRESH && select_1 < SELECT_1_THRESH && select_2 < SELECT_2_THRESH)
	{
		masp_enable = true;
	}

	// Operate MASP
	uint64_t current_vpn;
	current_vpn = addr;

	// Compute MASP tracker index and tag
	uint masp_index = ip % (MASP_TRACKER_SIZE/MASP_ASSOC);
	uint64_t masp_tag = ip / (MASP_TRACKER_SIZE/MASP_ASSOC);

	// Create variables for stride and previous VPN, and check for hit
	int64_t stride;
	uint64_t prev_vpn;
	bool tracker_hit = masp_tracker[masp_index].check_hit(masp_tag, &stride, &prev_vpn);

	// Perform prefetch only if entry exists
	if(tracker_hit)
	{
		uint64_t pf_addr[2];

		// Compute the two addresses that have to be prefetched
		pf_addr[0] = current_vpn + stride;
		pf_addr[1] = current_vpn + (current_vpn - prev_vpn);

		for(int i = 0; i < 2; i++)
		{
			// Prefetch to PQ only if MASP is enabled
			if(masp_enable)
			{
				ooo_cpu[cpu].STLB.prefetch_page(ip, addr, pf_addr[i], FILL_L2, 0, 0, 0, 0, instr_id, type, iflag, 0, 0, 0);
				masp_fpq.add_fpq(pf_addr[i]);
			}
			else  // Add addresses to FPQ
			{
				masp_fpq.add_fpq(pf_addr[i]);
			}

			// Perform free prefetches if SBFP is enabled
			#ifdef SBFP_ENABLE
			sbfp_operate(cpu, pf_addr[i], masp_enable, &masp_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
			#endif

			#ifdef AGILE_SEP_SAMPLER
			sbfp_operate_sep(cpu, pf_addr[i], masp_enable, &masp_fpq, addr, ip, cache_hit, type, answer, warmup, free_indexes, instr_id, iflag);
			#endif
		}

		// Update MASP tracker
		stride = current_vpn - prev_vpn;
		prev_vpn = current_vpn;
		masp_tracker[masp_index].update_entry(masp_tag, stride, prev_vpn);
		return;
	}

	// No hit in MASP tracker, so create new entry
	masp_tracker[masp_index].insert_entry(masp_tag, current_vpn);
}

void sbfp_operate(uint32_t cpu, uint64_t pf_addr, bool pf_en, fpq* pref_fpq, uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Compute base address (cache line aligned)
	uint64_t offset = pf_addr % 8;  // Each PTE entry is 8B and cache line is 64B
	uint64_t vpn_base = pf_addr - offset;

	// Check FDT and add free translations to Sampler or PQ
	for(int i = 0; i < 8; i++)
	{
		if(i != offset)
		{
			uint64_t vpn_free = vpn_base + i;
			int8_t free_distance = i - (int) offset;

			// Check FDT and make decision
			if(STLB_FDT.insert_sampler(free_distance))
			{
				if(pf_en)  // Add entry to sampler only if prefetcher is enabled
				{
					STLB_sampler.add_entry(vpn_free, free_distance);
				}
			}
			else
			{
				if(pf_en)  // Add to PQ only if prefetcher is enabled
				{
					ooo_cpu[cpu].STLB.prefetch_page(ip, addr, vpn_free, FILL_L2, 0, 1, 0, free_distance, instr_id, type, iflag, 0, 0, 0);
					pref_fpq->add_fpq(vpn_free);
				}
				else
				{
					pref_fpq->add_fpq(vpn_free);
				}
			}
		}
	}
}

void sbfp_operate_sep(uint32_t cpu, uint64_t pf_addr, bool pf_en, fpq* pref_fpq, uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, int answer, int warmup, int * free_indexes, uint64_t instr_id, int iflag)
{
	// Choose appropriate sampler and FDT
	sampler* sampler_ptr;
	fdt* fdt_ptr;

	if(stp_enable)
	{
		sampler_ptr = &stp_sampler;
		fdt_ptr = &stp_fdt;
	}
	else if(h2p_enable)
	{
		sampler_ptr = &h2p_sampler;
		fdt_ptr = &h2p_fdt;
	}
	else if(masp_enable)
	{
		sampler_ptr = &masp_sampler;
		fdt_ptr = &masp_fdt;
	}
	else  // Default sampler and FDT if no prefetcher is enabled
	{
		fdt_ptr = &STLB_FDT;
		sampler_ptr = &STLB_sampler;
	}
	
	// Compute base address (cache line aligned)
	uint64_t offset = pf_addr % 8;  // Each PTE entry is 8B and cache line is 64B
	uint64_t vpn_base = pf_addr - offset;

	// Check FDT and add free translations to Sampler or PQ
	for(int i = 0; i < 8; i++)
	{
		if(i != offset)
		{
			uint64_t vpn_free = vpn_base + i;
			int8_t free_distance = i - (int) offset;

			// Check FDT and make decision
			if(fdt_ptr->insert_sampler(free_distance))
			{
				sampler_ptr->add_entry(vpn_free, free_distance);
			}
			else
			{
				if(pf_en)  // Add to PQ only if prefetcher is enabled
				{
					ooo_cpu[cpu].STLB.prefetch_page(ip, addr, vpn_free, FILL_L2, 0, 1, 0, free_distance, instr_id, type, iflag, 0, 0, 0);
					pref_fpq->add_fpq(vpn_free);
				}
				else
				{
					pref_fpq->add_fpq(vpn_free);
				}
			}
		}
	}
}

bool MASP_set::check_hit(uint64_t ip_tag_check, int64_t* stride_ret, uint64_t* prev_vpn_ret)
{
	for(int i = 0; i < MASP_ASSOC; i++)
	{
		if(ip_tag[i] == ip_tag_check && valid[i] == 1)
		{
			*stride_ret = stride[i];
			*prev_vpn_ret = prev_vpn[i];

			// Update lru values
			for(int j = 0; j < MASP_ASSOC; j++)
			{
				if(lru[j] < lru[i] && valid[j] == 1)
				{
					lru[j]++;
				}
			}
			lru[i] = 0;
			return true;
		}
	}
	return false;
}

void MASP_set::update_entry(uint64_t ip_tag_update, int64_t stride_update, uint64_t prev_vpn_update)
{
	for(int i = 0; i < MASP_ASSOC; i++)
	{
		if(ip_tag[i] == ip_tag_update && valid[i] == 1)
		{
			stride[i] = stride_update;
			prev_vpn[i] = prev_vpn_update;
			return;
		}
	}
	
	// Should not reach here
	assert(0);
}

void MASP_set::insert_entry(uint64_t ip_tag_insert, uint64_t prev_vpn_insert)
{
	// Check if empty entry is available
	int entry = MASP_ASSOC;
	for(int i = 0; i < MASP_ASSOC; i++)
	{
		if(valid[i] == 0)
		{
			entry = i;
			break;
		}
	}

	// If no empty entry, evict LRU
	if(entry == MASP_ASSOC)
	{
		for(int i = 0; i < MASP_ASSOC; i++)
		{
			if(lru[i] == MASP_ASSOC - 1)
			{
				entry = i;
				break;
			}
		}
	}

	// Impossible condition
	if(entry == MASP_ASSOC)
	{
		assert(0);
	}

	// Enter new values into the entry
	ip_tag[entry] = ip_tag_insert;
	prev_vpn[entry] = prev_vpn_insert;
	stride[entry] = 0;
	valid[entry] = 1;

	// Update lru values
	for(int i = 0; i < MASP_ASSOC; i++)
	{
		if(i != entry && valid[i] == 1)
		{
			lru[i]++;
		}
	}
	lru[entry] = 0;
}

void MASP_set::print_set()
{
	for(int i = 0; i < MASP_ASSOC; i++)
	{
		cout << (uint) ip_tag[i] << " " << (uint) prev_vpn[i] << " " << (int) stride[i] << " " << (uint) valid[i] << " " << (uint) lru[i] << endl;
	}
}